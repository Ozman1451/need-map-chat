# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Pick models that show a free tier for your project in AI Studio (aistudio.google.com → rate limits)
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_BATCH_MODEL=gemini-3.5-flash-lite
EMBED_BACKEND=local
LOCAL_EMBED_MODEL=intfloat/multilingual-e5-base
# 1 = no network, canned LLM responses (tests, offline UI work)
MOCK_LLM=0
# synthetic (build/test) or real (final demo)
DATASET=synthetic
# Needed for Phase 5b real scraping (apify.com → Settings → API & Integrations)
APIFY_TOKEN=
